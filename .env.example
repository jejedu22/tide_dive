# Dossier hôte des modèles FES (créé et rempli par le service fetch-models)
FES_DIR=./models
# Modèle FES par défaut (FES2014 ou FES2022) pour le téléchargement et les calculs,
# tant qu'aucun modèle n'est choisi dans l'administration (Données et tâches)
FES_MODEL=FES2014

# Mémoire maximale du worker (précalculs). Serveur 4 Go : 1g ; augmenter si une tâche est tuée par manque de mémoire
WORKER_MEM_LIMIT=1g

# Compte AVISO+ ayant accès au produit FES (aviso.altimetry.fr)
AVISO_USERNAME=changeIt
AVISO_PASSWORD=changeIt

# Académie utilisée pour les vacances scolaires (Côtes-d'Armor = Rennes)
SCHOOL_ACADEMY=Rennes

API_PORT=8000

# Comptes utilisateurs : cookie de session réservé à HTTPS (mettre 1 derrière Traefik)
COOKIE_SECURE=0
# Durée de validité d'une connexion, en jours
SESSION_DAYS=30
# Mots de passe : longueur minimale (12 recommandé, 8 au minimum)
PASSWORD_MIN_LENGTH=12

# E-mails (invitations, mot de passe oublié)
# none : désactivé | console : écrit dans les logs du conteneur api (tests) | smtp : envoi réel
#
# Développement avec MailDev (docker compose --profile dev up -d),
# e-mails lisibles sur http://localhost:1080 :
#   MAIL_BACKEND=smtp
#   APP_BASE_URL=http://localhost:8000
#   SMTP_HOST=maildev
#   SMTP_PORT=1025
#   SMTP_SECURITY=none
#   SMTP_USER=
#   SMTP_PASSWORD=
#   MAIL_FROM="Marée <no-reply@maree.localhost>"
#   COOKIE_SECURE=0
MAIL_BACKEND=none
# URL publique, sans / final : sert à construire les liens des e-mails (obligatoire)
APP_BASE_URL=https://maree.example.fr
APP_NAME=Marée
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Marée <no-reply@example.fr>"
# Validité : lien d'invitation (jours) et mot de passe provisoire « oublié » (minutes)
INVITE_DAYS=7
RESET_TOKEN_MINUTES=60
# Port de l'interface web de MailDev (profil dev)
MAILDEV_WEB_PORT=1080
HOST_UID=changeIt
HOST_GID=changeIt
