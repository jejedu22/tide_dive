# Dossier hôte des modèles FES (créé et rempli par le service fetch-models)
FES_DIR=./models
# Modèle à télécharger : FES2014 ou FES2022 (doit correspondre à --model de precompute)
FES_MODEL=FES2014

# Compte AVISO+ ayant accès au produit FES (aviso.altimetry.fr)
AVISO_USERNAME=changeIt
AVISO_PASSWORD=changeIt

# Identifiants de ports passés à --port par le précalcul annuel (séparés par des espaces)
MAREE_PORTS=binic saint-quay-portrieux

# Académie utilisée pour les vacances scolaires (Côtes-d'Armor = Rennes)
SCHOOL_ACADEMY=Rennes

API_PORT=8000
HOST_UID=changeIt
HOST_GID=changeIt
