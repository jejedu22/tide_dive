# Dossier hôte des modèles FES (créé et rempli par le service fetch-models)
FES_DIR=./models
# Modèle FES par défaut (FES2014 ou FES2022) pour le téléchargement et les calculs,
# tant qu'aucun modèle n'est choisi dans l'administration (Données et tâches)
FES_MODEL=FES2014

# Mémoire maximale du worker (précalculs). Serveur 4 Go : 1g ; augmenter si une tâche est tuée par manque de mémoire
WORKER_MEM_LIMIT=1g

# Compte AVISO+ ayant accès au produit FES (aviso.altimetry.fr)
AVISO_USERNAME=changeIt
AVISO_PASSWORD=changeIt

# Clé api-maree.fr (gratuite, https://api-maree.fr) : recalage mensuel du modèle FES
# sur l'atlas Ifremer/PREVIMER. Vide : pas de recalage, hauteurs FES brutes
API_MAREE_KEY=

# Clé de chiffrement des secrets enregistrés en base (clés Mailjet des structures).
# Générer : docker compose run --rm --entrypoint python api -m app.secrets_store generate
# À sauvegarder À PART de la base : la perdre oblige à ressaisir les clés Mailjet.
SECRETS_KEY=

# Alertes (données manquantes, tâche en échec, sauvegarde absente…) : adresses séparées par des virgules.
# Vide : les super administrateurs ayant une adresse e-mail. Nécessite MAIL_BACKEND=smtp.
ALERT_EMAIL=

# Sauvegardes quotidiennes de la base (data/backups/) : nombre d'exemplaires conservés
BACKUP_KEEP=14

# Académie utilisée pour les vacances scolaires (Côtes-d'Armor = Rennes)
SCHOOL_ACADEMY=Rennes

# Nom de domaine public (DNS vers le serveur) : règle Host() de Traefik + certificat Let's Encrypt
MAREE_HOST=calendive.fr
# Port publié sur l'hôte, uniquement en local avec docker-compose.local.yml (sans Traefik)
API_PORT=8000

# Sécurité de l'API
# Nombre de proxys de confiance devant l'API (Traefik : 1 ; 0 si l'API est exposée directement) :
# sert à retrouver l'adresse IP réelle des clients pour limiter les tentatives de connexion
TRUSTED_PROXY_HOPS=1
# Origines autorisées à appeler l'API depuis un navigateur (CORS), séparées par des virgules. Vide : aucune
# (le site est servi par l'API elle-même, ce qui n'en a pas besoin)
CORS_ORIGINS=

# Comptes utilisateurs : cookie de session réservé à HTTPS (1 derrière Traefik, 0 en local en http)
COOKIE_SECURE=1
# Durée de validité d'une connexion, en jours
SESSION_DAYS=30
# Mots de passe : longueur minimale (12 recommandé, 8 au minimum)
PASSWORD_MIN_LENGTH=12

# E-mails (invitations, mot de passe oublié)
# none : désactivé | console : écrit dans les logs du conteneur api (tests) | smtp : envoi réel
#
# Développement avec MailDev (docker compose --profile dev up -d),
# e-mails lisibles sur http://localhost:1080 :
#   MAIL_BACKEND=smtp
#   APP_BASE_URL=http://localhost:8000
#   SMTP_HOST=maildev
#   SMTP_PORT=1025
#   SMTP_SECURITY=none
#   SMTP_USER=
#   SMTP_PASSWORD=
#   MAIL_FROM="Calendive <no-reply@calendive.localhost>"
#   COOKIE_SECURE=0
MAIL_BACKEND=none
# URL publique, sans / final : sert à construire les liens des e-mails (obligatoire)
APP_BASE_URL=https://calendive.fr
APP_NAME=Calendive
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Calendive <no-reply@calendive.fr>"
# Validité : lien d'invitation (jours) et mot de passe provisoire « oublié » (minutes)
INVITE_DAYS=7
RESET_TOKEN_MINUTES=60
# Port de l'interface web de MailDev (profil dev)
MAILDEV_WEB_PORT=1080
HOST_UID=changeIt
HOST_GID=changeIt
